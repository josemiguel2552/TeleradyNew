# Telerady local agent — example environment

# Required: backend base URL and credentials
TELERADY_API_URL=https://api.telerady.es
TELERADY_API_TOKEN=

# Optional client-certificate authentication (mTLS) — recommended.
# Paths to PEM-encoded files on disk.
TELERADY_CLIENT_CERT=
TELERADY_CLIENT_KEY=
TELERADY_CA=

# Folder that the agent watches for new DICOM files.
WATCH_FOLDER=/var/lib/telerady/incoming

# Folder where successfully uploaded files are moved.
ARCHIVE_FOLDER=/var/lib/telerady/sent

# Folder for files that fail and need operator review.
QUARANTINE_FOLDER=/var/lib/telerady/quarantine

# Polling interval for stable-file detection (ms).
STABILITY_THRESHOLD_MS=5000

# Maximum concurrent uploads.
MAX_CONCURRENT_UPLOADS=2

# Logging level (debug, info, warn, error).
LOG_LEVEL=info
