{
  "name": "telerady-agent",
  "version": "0.1.0",
  "description": "Telerady local agent — watches a DICOM folder, encrypts and pushes studies via STOW-RS",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "telerady-agent": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.7",
    "pino": "^9.7.0",
    "pino-pretty": "^11.3.0",
    "undici": "^7.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
    "testRegex": ".*\\.spec\\.ts$"
  }
}
