# =====================================================================
# Telerady — example environment variables (development)
# Copy to `.env` and fill real values. NEVER commit `.env`.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---------- Database ----------
DATABASE_URL=postgres://telerady:telerady@localhost:5432/telerady
DATABASE_SSL=false

# ---------- Redis (cache + queues) ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# Use 64+ random bytes. Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=telerady
JWT_AUDIENCE=telerady-api

# ---------- Cookies ----------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- CORS ----------
# Comma separated allowlist. Use a single origin in prod.
CORS_ORIGINS=http://localhost:4200

# ---------- Encryption (column-level AES-256-GCM) ----------
# Master key wrapping. 32 bytes hex (64 hex chars). Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=replace-with-32-bytes-hex
# Pepper for pseudonymization hashing (HMAC-SHA256 of identifiers). Different from master key.
PSEUDONYM_PEPPER=replace-with-different-32-bytes-hex

# ---------- Object storage (MinIO / S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-south-2
S3_ACCESS_KEY=teleradyminio
S3_SECRET_KEY=teleradyminio
S3_BUCKET_REPORTS=telerady-reports
S3_BUCKET_DOCUMENTS=telerady-documents
S3_FORCE_PATH_STYLE=true

# ---------- Orthanc (PACS) ----------
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=telerady
ORTHANC_PASSWORD=telerady
ORTHANC_DICOMWEB_PATH=/dicom-web
ORTHANC_MAX_UPLOAD_MB=512

# ---------- OHIF viewer ----------
OHIF_URL=http://localhost:3001
OHIF_VIEWER_PATH=/viewer

# ---------- Rate limiting ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---------- Compliance ----------
# Days. Per-hospital override stored in DB.
DEFAULT_RETENTION_DAYS=3650
AUDIT_HASH_CHAIN_SEED=replace-with-random-32-bytes-hex

# ---------- Row Level Security ----------
# Set to "true" only after applying infra/migrations/001-enable-rls.sql
# and running the API under a role that has BYPASSRLS off (telerady_app).
# Activating it makes the RlsContextInterceptor push the per-request
# tenant scope as session-local GUCs before each handler runs.
RLS_ENABLED=false

# ---------- Notifications ----------
EMAIL_FROM=no-reply@telerady.es
# HMAC-SHA256 secret for outbound webhooks. Rotate periodically.
WEBHOOK_OUTGOING_SECRET=replace-with-random-32-bytes-hex

# ---------- HL7 v2 MLLP ----------
# Enable the inbound MLLP listener. Run behind a TLS terminator
# (Stunnel / nginx stream) in production.
HL7_MLLP_ENABLED=false
HL7_MLLP_PORT=2575

# ---------- AI draft provider selection ----------
# radiogenai (default, external service, RGPD art. 28 applies)
# ollama     (local runtime, no data leaves the perimeter)
# disabled   (any other value → /ai-draft replies 503)
AI_DRAFT_PROVIDER=radiogenai

# ---------- RadiogenAI (external draft generation) ----------
# When unset, the AI-draft endpoint returns 503 ("integration disabled").
RADIOGENAI_URL=
RADIOGENAI_API_KEY=
RADIOGENAI_TIMEOUT_MS=60000
RADIOGENAI_DEFAULT_LANGUAGE=es

# ---------- Ollama (local AI runtime) ----------
# Only consulted when AI_DRAFT_PROVIDER=ollama. Point OLLAMA_URL at the
# in-cluster service (e.g. http://ollama:11434). The model must be
# already pulled on the runtime. Streaming via /api/generate (NDJSON).
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b-instruct
OLLAMA_TIMEOUT_MS=120000

# ---------- Inbound integrations (MPPS, HL7 ack hooks) ----------
# Shared secret expected in the x-api-key header. 32+ chars. When unset
# all /v1/integrations/* endpoints respond 503.
INTEGRATION_API_KEY=

# ---------- Web Push (RFC 8292 VAPID) ----------
# Generate once with: npx web-push generate-vapid-keys
# When the keys are missing the push endpoints return 503 and the SPA
# never gets the public key, so users can't subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@telerady.es
