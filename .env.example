# =====================================================================
# Telerady — example environment variables (development)
# Copy to `.env` and fill real values. NEVER commit `.env`.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---------- Database ----------
DATABASE_URL=postgres://telerady:telerady@localhost:5432/telerady
DATABASE_SSL=false

# ---------- Redis (cache + queues) ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# Use 64+ random bytes. Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=telerady
JWT_AUDIENCE=telerady-api

# ---------- Cookies ----------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- CORS ----------
# Comma separated allowlist. Use a single origin in prod.
CORS_ORIGINS=http://localhost:4200

# ---------- Encryption (column-level AES-256-GCM) ----------
# Master key wrapping. 32 bytes hex (64 hex chars). Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=replace-with-32-bytes-hex
# Pepper for pseudonymization hashing (HMAC-SHA256 of identifiers). Different from master key.
PSEUDONYM_PEPPER=replace-with-different-32-bytes-hex

# ---------- Object storage (MinIO / S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-south-2
S3_ACCESS_KEY=teleradyminio
S3_SECRET_KEY=teleradyminio
S3_BUCKET_REPORTS=telerady-reports
S3_BUCKET_DOCUMENTS=telerady-documents
S3_FORCE_PATH_STYLE=true

# ---------- Orthanc (PACS) ----------
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=telerady
ORTHANC_PASSWORD=telerady
ORTHANC_DICOMWEB_PATH=/dicom-web
ORTHANC_MAX_UPLOAD_MB=512

# ---------- OHIF viewer ----------
OHIF_URL=http://localhost:3001
OHIF_VIEWER_PATH=/viewer

# ---------- Google Drive (legacy — to be deprecated in Sprint 2) ----------
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
FOLDER_TELERADY_DOC_ID=

# ---------- Rate limiting ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---------- Compliance ----------
# Days. Per-hospital override stored in DB.
DEFAULT_RETENTION_DAYS=3650
AUDIT_HASH_CHAIN_SEED=replace-with-random-32-bytes-hex
